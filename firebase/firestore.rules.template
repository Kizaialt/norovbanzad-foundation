rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The website reads the saved texts, so anyone may read them.
    match /texts/{id} {
      allow read: if true;

      // A text can only be written in the same commit as a "proof" document carrying the edit
      // passcode (see assets/js/live.js). The proof is never readable, so the passcode is never
      // exposed, and nothing can be deleted.
      allow create, update: if id.matches('^(mn|en|all)__[A-Za-z0-9._-]{1,100}$')
        && getAfter(/databases/$(database)/documents/proofs/$(id)).data.pass == '__PASSCODE__'
        && request.resource.data.keys().hasOnly(['html', 'by', 'at', 'prev'])
        && request.resource.data.html is string
        && request.resource.data.html.size() < 8000;
      allow delete: if false;
    }

    // Every save also leaves a permanent copy here, so an overwritten or mistaken edit can always
    // be recovered. Append-only: the passcode lets you add entries, never change or delete them,
    // and the public cannot read them (only the project owner can, from the console or the API).
    // The entry id is "<text id>~<time>", and the proof for <text id> is in the same commit.
    match /history/{hid} {
      allow create: if hid.matches('^(mn|en|all)__[A-Za-z0-9._-]{1,100}~[0-9]{10,16}$')
        && getAfter(/databases/$(database)/documents/proofs/$(hid.split('~')[0])).data.pass == '__PASSCODE__'
        && request.resource.data.keys().hasOnly(['html', 'by', 'at', 'prev'])
        && request.resource.data.html is string
        && request.resource.data.html.size() < 8000;
      allow read, update, delete: if false;
    }

    match /proofs/{id} {
      allow create, update: if id.matches('^(mn|en|all)__[A-Za-z0-9._-]{1,100}$')
        && request.resource.data.keys().hasOnly(['pass'])
        && request.resource.data.pass is string
        && request.resource.data.pass.size() < 200;
      allow read, delete: if false;
    }
  }
}
